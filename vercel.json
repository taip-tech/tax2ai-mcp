{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/mcp.js": {
      "maxDuration": 60,
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/healthz",
      "destination": "/api/mcp?health=1"
    },
    {
      "source": "/.well-known/:path*",
      "destination": "/api/mcp?wk=:path*"
    }
  ],
  "cleanUrls": true,
  "framework": null,
  "regions": [
    "icn1"
  ]
}
