# 국가법령정보 공동활용(open.law.go.kr)에서 발급받은 OC 값 (가입 이메일의 @ 앞부분)
LAWGO_OC=

# 업스트림 설정
LAWGO_BASE_URL=https://www.law.go.kr/DRF
LAWGO_TIMEOUT_MS=10000
LAWGO_MAX_PARALLEL=4

# 캐시 TTL (초)
CACHE_TTL_SEARCH=1800
CACHE_TTL_DOCUMENT=43200

# 응답 본문 최대 글자 수 (초과 시 cursor로 이어받기)
REPLY_CHAR_BUDGET=14000

# HTTP 모드 (--http) 전용
HTTP_HOST=127.0.0.1
HTTP_PORT=8787
# 외부 바인딩 시 반드시 설정: Authorization: Bearer <값>
MCP_ACCESS_TOKEN=

# 공개 서비스 (mcp.tax2.ai)
# 토큰 없이 공개하려면 PUBLIC_MODE=1 (IP당 분당 호출 제한 적용)
PUBLIC_MODE=0
RATE_LIMIT_PER_MIN=30
# Caddy/Nginx 등 리버스 프록시 뒤에서만 1
TRUST_PROXY=0
PUBLIC_ENDPOINT=https://mcp.tax2.ai/mcp

# 출처 표기 (Powered by)
BRAND_NAME=TAX2.AI
BRAND_URL=https://tax2.ai
BRAND_ATTRIBUTION=1

# 사용자 본인 OC
# 사용자는 X-Lawgo-OC 헤더 또는 연결 주소 ?oc=본인OC 로 보낼 수 있다 (오면 서버 키보다 우선)
# 1이면 사용자 OC가 없을 때 서버 키로 대신 호출하지 않는다
REQUIRE_USER_OC=0
# 0이면 ?oc= 쿼리를 무시하고 헤더만 받는다 (URL은 접근 로그에 남을 수 있음)
ALLOW_QUERY_OC=1

# 서버 공용 키의 하루 법제처 호출 한도 (캐시 적중 제외, 0=무제한). 넘으면 본인 OC 사용 안내
SERVER_KEY_DAILY_LIMIT=0
# 브라우저 Origin 허용 목록 (쉼표 구분, *는 전부). 비우면 공개 모드에선 전부 허용, 그 밖엔 Origin 헤더 요청 차단
ALLOWED_ORIGINS=
# 요청 경로·상태·소요시간만 기록 (쿼리·본문 제외)
ACCESS_LOG=0

# 법제처 호출 시 Referer (기본: PUBLIC_ENDPOINT의 origin). 법제처 신청 정보에 같은 도메인을 등록
LAWGO_REFERER=

# 사용자 로그인 (OAuth 2.1). oauth로 두면 Claude 커넥터 연결 시 TAX2.AI 로그인을 거친다
AUTH_MODE=none
# 인증 서버 issuer (TAX2 플랫폼 Supabase): https://<project-ref>.supabase.co/auth/v1
OAUTH_ISSUER=
# 지정 시 토큰 aud 검증 (Supabase 액세스 토큰 훅으로 aud를 설정한 경우)
OAUTH_AUDIENCE=
